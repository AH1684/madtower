grf {
	grfid: "MBT1";
	name: string(STR_GRF_NAME);
	desc: string(STR_GRF_DESC);
	url:  string(STR_GRF_URL);
	version: 1;
	min_compatible_version: 0;
	param 0 {
		param_remove {
			name:      string(STR_PAR_REMOVE_NAME);
			desc:      string(STR_PAR_REMOVE_DESC);
			type:      bool;
			def_value: 0;
		}
	}
}

// GROUND
spriteset (spriteset_sandstone, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/sandstone.png") {[0, 0, 64, 31, -31, 0]}
spriteset (spriteset_empty, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/empty_pixel.png") {[0, 0, 1, 1, 0, 0]}

