spritelayout spritelayout_madtower_a_0_0 {
	ground { sprite: spriteset_sandstone(); }
	childsprite { sprite: GROUNDSPRITE_SNOW; hide_sprite: nearby_tile_height(0,0) < snowline_height; }
	building { sprite: spriteset_madtower_a_0_0(); zextent: 250; }
	building { sprite: spriteset_madtower_a_0_0_snow(); hide_sprite: (nearby_tile_height(0,0) < snowline_height); zextent: 250; } }
